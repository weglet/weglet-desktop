    # //components/spellcheck/browser itself -- see the comment by its
    # files further up in sources.
    "//components/spellcheck/common",
    "//components/spellcheck/renderer",
    # Ctrl+/Ctrl-/Ctrl+0 -- see WegletWindow::ZoomActiveTab.
    "//components/zoom",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    # window.chrome.loadTimes()/csi() -- see weglet_loadtimes_bindings.cc.
    "//gin",
    "//net",
    # SimpleURLLoader, for the threat feed fetch -- see weglet_bridge.cc.
    "//services/network/public/cpp",
    "//third_party/blink/public:blink",
    "//ui/base",
    "//ui/display",
    # The native file-picker dialog behind <input type=file> -- see
    # weglet_file_select_helper.cc.
    "//ui/shell_dialogs",
    "//url",
  ]

  # Chromium on desktop draws through Aura, so a WebContents needs a
  # views::Widget to live in. The same route content_shell takes.
  if (use_aura) {
    deps += [
      "//ui/aura",
      "//ui/views",
      "//ui/views/controls/webview",
      "//ui/wm",
      "//ui/wm/public",
    ]
  }
}

# Unit tests. Run with: ninja -C out/Default weglet_unittests &&
# out/Default/weglet_unittests
#
# generators_test.py checks that the generator writes the right text; this
# checks that the text means the right thing once compiled.
test("weglet_unittests") {
  sources = [ "browser/weglet_contract_unittest.cc" ]

  deps = [
    "ui",
    "//base",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}

# A mistake in contract.json or tokens.json does not fail in the
# generators; it produces generated C++ that fails to compile with an
# error pointing at a file nobody wrote.
action("check_generators") {
  script = "ui/generators_test.py"
  inputs = [
    "ui/contract.json",
    "ui/generate_contract.py",
    "ui/generate_tokens.py",
    "ui/tokens.json",
  ]
  outputs = [ "$target_gen_dir/generators_test.stamp" ]
  args = [
    "--stamp",
    rebase_path("$target_gen_dir/generators_test.stamp", root_build_dir),
  ]
}

# protocol.ts validates every push before a page acts on it. Run under the
# same vendored node build_ui.py compiles with -- no npm, no node_modules.
action("check_ui") {
  script = "ui/run_ui_tests.py"
  # Coarse on purpose, like ui/BUILD.gn's build_ui action: a depfile
  # listing every .ts would be a second copy of the source list.
  inputs = [
    "build_support.py",
    "ui/contract.json",
    "ui/generate_contract.py",
    "ui/generate_tokens.py",
    "ui/test/protocol_test.ts",
    "ui/tokens.json",
  ]
  outputs = [ "$target_gen_dir/ui_test.stamp" ]
  args = [
    "--chromium-root",
    rebase_path("//", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/ui_test.stamp", root_build_dir),
  ]
}

# Which Chromium revision weglet/CHROMIUM_VERSION says this is meant to be.
action("check_chromium_version") {
  script = "check_chromium_version.py"
  inputs = [
    "CHROMIUM_VERSION",
    "//chrome/VERSION",
  ]
  outputs = [ "$target_gen_dir/chromium_version_check.stamp" ]
  args = [
    "--expected",
    rebase_path("CHROMIUM_VERSION", root_build_dir),
    "--actual",
    rebase_path("//chrome/VERSION", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/chromium_version_check.stamp", root_build_dir),
  ]
}

# Keeps weglet_pak's hand-written list honest against the one it was
# trimmed from. See check_pak.py.
action("check_pak") {
  script = "check_pak.py"
  inputs = [
    "BUILD.gn",
    "pak_exclusions.txt",
    "//content/shell/BUILD.gn",
  ]
  outputs = [ "$target_gen_dir/pak_check.stamp" ]
  args = [
    "--weglet-build",
    rebase_path("BUILD.gn", root_build_dir),
    "--shell-build",
    rebase_path("//content/shell/BUILD.gn", root_build_dir),
    "--exclusions",
    rebase_path("pak_exclusions.txt", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/pak_check.stamp", root_build_dir),
  ]
}

# Without a resource pack, startup trips on the first string or image the
# content layer asks ResourceBundle for.
#
# Taken from content/shell's own "pak" target and trimmed. Whenever
# Chromium is updated, diff this against content/shell/BUILD.gn -- a
# resource added there is usually one the content layer now expects every
# embedder to have.
repack("weglet_pak") {
  sources = [
    "$root_gen_dir/base/tracing/protos/tracing_proto_resources.pak",
    "$root_gen_dir/content/browser/devtools/devtools_resources.pak",
    "$root_gen_dir/content/browser/resources/media/media_internals_resources.pak",
    "$root_gen_dir/content/browser/webrtc/resources/webrtc_internals_resources.pak",
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/histograms_resources.pak",
    "$root_gen_dir/content/process_resources.pak",
    "$root_gen_dir/content/quota_internals_resources.pak",
    "$root_gen_dir/content/service_worker_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_lottie_resources.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]

  deps = [
    "//base/tracing/protos:chrome_track_event_resources",
    "//content:content_resources",
    "//content/browser/devtools:devtools_resources",
    "//content/browser/resources",
    "//content/browser/resources/media:resources",
    "//content/browser/webrtc/resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]

  if (!is_android && !is_ios) {
    deps += [ "//content/browser/tracing:resources" ]
    sources += [
      "$root_gen_dir/content/browser/tracing/tracing_resources.pak",
      "$root_gen_dir/content/traces_internals_resources.pak",
    ]
  }

  # The window is a views::Widget on every desktop platform, and views has
  # resources of its own. content/shell guards the same two lines with
  # shell_use_toolkit_views; the condition here is use_aura, which is what
  # decides whether Weglet links views at all.
  if (use_aura) {
    deps += [ "//ui/views/resources" ]
    sources +=
        [ "$root_gen_dir/ui/views/resources/views_resources_100_percent.pak" ]
  }

  output = "$root_out_dir/weglet.pak"
}
