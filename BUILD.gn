# Everything Weglet adds to Chromium lives under this directory, so
# rebasing onto a new Chromium release is a fetch, not a merge.

import("//build/config/ui.gni")
import("//testing/test.gni")
import("//tools/grit/repack.gni")

executable("weglet") {
  sources = [ "app/weglet_main.cc" ]

  deps = [
    ":weglet_lib",
    "//base",
    "//build/win:default_exe_manifest",
    "//content/public/app",
  ]

  # No console window on a GUI build; the log file is the log.
  if (is_win) {
    configs -= [ "//build/config/win:console" ]
    configs += [ "//build/config/win:windowed" ]
    deps += [
      # content::InitializeSandboxInfo lives here, not in
      # //content/public/app. Without it the link fails.
      "//content:sandbox_helper_win",
      "//sandbox/win:sandbox",
    ]
  }

  data_deps = [
    ":weglet_pak",

    # v8_context_snapshot.bin. Every child process except the GPU one loads
    # it at startup and stops with a fatal error when the file is missing.
    "//tools/v8_context_snapshot",

    # Not a build input: it is here so the comparison runs. A resource
    # pack Chromium started expecting is otherwise found by a CHECK at
    # startup.
    ":check_pak",

    # Says which Chromium tree this is. A warning by default.
    ":check_chromium_version",

    # Neither produces anything the binary uses; both are here so they run.
    ":check_generators",
    ":check_ui",
  ]
}

