# Cargo builds one shared library; weglet links against it and loads it
# from its own directory. See build_rust.py.

import("//build/config/rust.gni")

# A macOS dylib records the absolute path of cargo's output as its install
# name unless rustc is given one, and nothing here sets one or copies the
# dylib into an app bundle.
assert(!is_mac, "weglet_ffi is not set up as a macOS dylib")

declare_args() {
  # Debug Rust with a debug Chromium. Off even in a debug build: a debug
  # build of the security corpus is noticeably slower.
  weglet_rust_debug = false
}

_profile = "release"
if (weglet_rust_debug) {
  _profile = "debug"
}

# Next to the executable: Windows and the $ORIGIN rpath both look there.
if (is_win) {
  _shared_library_path = "$root_out_dir/weglet_ffi.dll"
  _import_library_path = "$target_out_dir/weglet_ffi.dll.lib"
} else {
  _shared_library_path = "$root_out_dir/libweglet_ffi.so"
}

action("weglet_ffi_build") {
  script = "build_rust.py"

  # Not listed file by file: the depfile below is generated from the
  # actual sources.
  inputs = [
    # The shared build helpers both this and the other scripts import.
    "//weglet/build_support.py",

    # Compiled in with include_str!, so a change to one is a rebuild. The
    # depfile lists .rs and the manifests; these are data.
    "weglet-profile/data/engines.json",
    "weglet-security/data/blocklist.txt",
    "weglet-security/data/brands.json",
    "weglet-security/data/sensitive_words.txt",
    "//weglet/rust/Cargo.toml",
    "//weglet/rust/Cargo.lock",
  ]

  outputs = [ _shared_library_path ]
  if (is_win) {
    outputs += [ _import_library_path ]
  }
  depfile = "$target_out_dir/weglet_ffi.d"

  args = [
    "--manifest",
    rebase_path("//weglet/rust/Cargo.toml", root_build_dir),
    "--target",
    rust_abi_target,

    # Its own target directory inside the GN output tree: sharing one with
    # a developer's `cargo build` means fighting over the same lock.
    "--target-dir",
    rebase_path("$target_out_dir/rust", root_build_dir),
    "--profile",
    _profile,
    "--depfile",
    rebase_path(depfile, root_build_dir),
  ]
  foreach(output, outputs) {
    args += [
      "--out",
      rebase_path(output, root_build_dir),
    ]
  }
}

# What the rest of the build depends on: the header path, the library to
# link against, and the shared library to ship next to the executable.
group("weglet_ffi") {
  public_configs = [ ":weglet_ffi_config" ]
  deps = [ ":weglet_ffi_build" ]
  data = [ _shared_library_path ]

  # All dependents rather than public: GN applies ldflags only to the
  # target that links, and that is the executable, not weglet_lib.
  if (!is_win) {
    all_dependent_configs =
        [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  }
}

config("weglet_ffi_config") {
  include_dirs = [ "//weglet" ]

  if (is_win) {
    libs = [ _import_library_path ]
  } else {
    # -l rather than the path, so the executable records the bare file
    # name and finds the library through the rpath.
    lib_dirs = [ root_out_dir ]
    libs = [ "weglet_ffi" ]
  }
}
