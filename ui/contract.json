  "$pushes_comment": [
    "The other direction: what the browser calls on a page.",
    "",
    "'function' is installed by the page under the namespace the generator",
    "emits, and called as <namespace>.<function> from C++.",
    "",
    "'page' is which page receives it, by the key from the pages block --",
    "which is also what lets the browser push only to the pages a change",
    "concerns."
  ],
  "pushes": {
    "state": {
      "page": "toolbar",
      "function": "setState"
    },
    "newTab": {
      "page": "newtab",
      "function": "setNewTab"
    },
    "settings": {
