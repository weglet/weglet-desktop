  },
  "internal_addresses": {
    "$comment": [
      "The addresses the tab model knows as its own, in the form the user",
      "sees them. weglet-core owns the literal strings and this list has to",
      "name the same four.",
      "",
      "'page' is which page stands in for the address."
    ],
    "blank-tab": {
      "address": "about:blank",
      "page": "newtab"
    },
    "settings": {
      "address": "weglet://settings",
      "page": "settings"
    },
    "history": {
      "address": "weglet://history",
      "page": "history"
    },
    "bookmarks": {
